<this:ConstructionMenu xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:c="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:this="clr-namespace:Content.Client.Construction.UI"
    xmlns:cc="clr-namespace:Content.Client.Construction.UI.Controls"
    SetSize="560 450"
    MinSize="560 320">

    <HBox SeparationOverride="10">
        <c:FancyWindow Name="RecipesCatalogWindow"
                       Title="{Loc construction-menu-catalog-title}">
            <VBox SeparationOverride="1">
                <HBox SeparationOverride="1">
                    <LineEdit Name="RecipeSearch"
                              MinWidth="64"
                              HorizontalExpand="True"/>
                    <OptionButton Name="CategorySelect"/>
                </HBox>
                <GridContainer Name="RecipesContainer"
                               HorizontalExpand="True"
                               VerticalExpand="True">
                    <!-- Recipes was added here by code -->
                </GridContainer>
            </VBox>
        </c:FancyWindow>
        <c:FancyWindow Name="RecipeInfoWindow"
                       Visible="False">
            <VBox SeparationOverride="8">
                <RichTextLabel Name="RecipeDescriptionLabel"
                               HorizontalExpand="True"/>
                <PanelContainer StyleClasses="AngleRect"
                                ModulateSelfOverride="#00000018"
                                MaxWidth="160">
                    <VBox Margin="8" SetSize="160 64">
                        
                    </VBox>
                </PanelContainer>
            </VBox>
        </c:FancyWindow>
    </HBox>
</this:ConstructionMenu>
